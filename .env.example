# =============================================================================
# CESIZen - Variables d'environnement (template)
# =============================================================================
# Copier ce fichier vers .env.local (dev) ou .env (Docker Compose production).
# AUCUN SECRET ne doit être versionné dans Git.
# =============================================================================

# =============================================================================
# 1. BASE DE DONNÉES POSTGRESQL
# =============================================================================
# Utilisateur et base de la base de données
POSTGRES_USER=postgres
POSTGRES_DB=cesizen

# ⚠️ OBLIGATOIRE : Changer le mot de passe PostgreSQL
# Générer un mot de passe fort : openssl rand -base64 24
POSTGRES_PASSWORD=your-secure-password-here

# URL de connexion (doit correspondre au mot de passe ci-dessus)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DB
# En Docker Compose : le host est 'db' (nom du service)
DATABASE_URL=postgresql://postgres:your-secure-password-here@db:5432/cesizen

# =============================================================================
# 2. AUTHENTIFICATION (NextAuth.js)
# =============================================================================
# ⚠️ OBLIGATOIRE : Générer une clé forte
# Commande : openssl rand -base64 32
# Longueur minimale : 32 caractères
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars-here

# URL de l'application (pour les cookies et les redirections)
# En local : http://localhost:3333
NEXTAUTH_URL=http://localhost:3333

# =============================================================================
# 3. APPLICATION
# =============================================================================
# Port d'accès de l'application (host)
# L'application Next.js tourne sur le port 3000 dans le conteneur
# Le port 3333 est exposé sur l'hôte
APP_PORT=3333

# =============================================================================
# 4. SÉGRÉGATION DES SECRETS (SQLite)
# =============================================================================
# Chemin vers la base SQLite contenant les peppers (sécrets)
# JAMAIS dans PostgreSQL, toujours dans un fichier séparé
# En Docker : /secrets/secrets.db (volume persistant)
# En local : ./secrets.db (non versionné dans Git)
SECRETS_DB_PATH=./secrets.db

# =============================================================================
# 5. LOGGING (optionnel)
# =============================================================================
# Niveau de log : debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# 6. SÉCURITÉ ADDITIONNELLE (optionnel pour la démo)
# =============================================================================
# URL interne pour NextAuth (si reverse proxy)
# NEXTAUTH_URL_INTERNAL=http://app:3000

# Forcer le trust host (si derrière un reverse proxy)
# TRUST_HOST=true

# =============================================================================
# CHECKLIST AVANT DÉMARRAGE
# =============================================================================
# [ ] POSTGRES_PASSWORD changé (pas la valeur par défaut)
# [ ] NEXTAUTH_SECRET changé (32+ caractères aléatoires)
# [ ] DATABASE_URL mis à jour avec le mot de passe
# [ ] APP_PORT configuré (3333 par défaut)
# [ ] SECRETS_DB_PATH configuré (./secrets.db en local)
# [ ] Ce fichier n'est PAS versionné dans Git (.gitignore)
# =============================================================================
